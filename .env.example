# Configuración de base de datos
DB_HOST=localhost
DB_NAME=ferredog
DB_USER=root
DB_PASS=

# Configuración de correo
# Modo: "prueba" (escribe en storage/logs/correos.log) o "gmail" (envía por Gmail)
MAIL_MODO=prueba

# Configuración SMTP de Gmail (solo si MAIL_MODO=gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_cuenta@gmail.com
MAIL_PASS=tu_contrasena_de_aplicacion
MAIL_FROM_NAME=Ferredog
