# Configuración de base de datos
DB_HOST=localhost
DB_NAME=ferredog
DB_USER=root
DB_PASS=

# Configuración de correo
# Modo: "prueba" (escribe en storage/logs/correos.log) o "smtp" (envía por Gmail)
MAIL_MODO=prueba

# Configuración SMTP (solo si MAIL_MODO=smtp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contraseña_aplicacion
MAIL_FROM_NAME=Ferredog
